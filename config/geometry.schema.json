{
  "type": "object",
  "required": [
    "chamber",
    "coils",
    "domain",
    "downstream",
    "mesh"
  ],
  "additionalProperties": false,
  "properties": {
    "chamber": {
      "type": "object",
      "required": [
        "radius",
        "length",
        "z_start",
        "wall_thickness"
      ],
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_start": {
          "type": "number"
        },
        "wall_thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "coils": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "radius",
          "z_center",
          "turns",
          "current",
          "radial_thickness",
          "axial_width"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "z_center": {
            "type": "number"
          },
          "turns": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "current": {
            "type": "number"
          },
          "radial_thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "axial_width": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "radius",
        "z_min",
        "z_max"
      ],
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_min": {
          "type": "number"
        },
        "z_max": {
          "type": "number"
        }
      }
    },
    "downstream": {
      "type": "object",
      "required": [
        "radius",
        "length"
      ],
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "mesh": {
      "type": "object",
      "required": [
        "chamber",
        "wall",
        "coil",
        "downstream",
        "far"
      ],
      "additionalProperties": false,
      "properties": {
        "chamber": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wall": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coil": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "downstream": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "far": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Helicon geometry (SI units)",
  "description": "Cross-region containment, finite values, and nonoverlap also checked by helicon.config.validate."
}
